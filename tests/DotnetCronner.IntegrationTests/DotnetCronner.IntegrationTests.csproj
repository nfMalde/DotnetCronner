<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Real-backend evidence for the "one run per task across processes" guarantee: the shared lock contract and the
    two-scheduler exclusivity tests (tests/DotnetCronner.Tests/Shared) against PostgreSQL, SQL Server (READ COMMITTED
    with and without snapshot) and Redis, each started in a Docker container via Testcontainers.

    When Docker is not reachable the tests are SKIPPED, not failed — unless CRONNER_REQUIRE_DOCKER=1 is set (CI), in
    which case they run and fail loudly if Docker is missing.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="Testcontainers" Version="4.14.0" />
    <PackageReference Include="Testcontainers.MsSql" Version="4.14.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.14.0" />
    <PackageReference Include="Testcontainers.Redis" Version="4.14.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The contract tests themselves live in the unit project and are compiled in here, so both projects run the
         very same assertions — only the backend differs. -->
    <Compile Include="..\DotnetCronner.Tests\Shared\**\*.cs" LinkBase="Shared" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DotnetCronner\DotnetCronner.csproj" />
    <ProjectReference Include="..\..\src\DotnetCronner.Abstractions\DotnetCronner.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\DotnetCronner.Stores.Redis\DotnetCronner.Stores.Redis.csproj" />
    <ProjectReference Include="..\..\src\DotnetCronner.Stores.EntityFrameworkCore\DotnetCronner.Stores.EntityFrameworkCore.csproj" />
  </ItemGroup>

</Project>
