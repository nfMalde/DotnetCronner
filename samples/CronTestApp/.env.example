# ─────────────────────────────────────────────────────────────────────────────────────────────
#  DotnetCronner test harness — copy this file to `.env` and tweak. This file steers everything.
#
#  Read by:  docker compose (services + variable substitution) AND the app itself (DotEnvFile),
#            so `docker compose up` and F5 / `dotnet run` behave the same.
#  Note:     values set by docker compose (container host names) always beat this file.
#  After changing a value: restart the app (`docker compose up -d --force-recreate crontestapp`).
#
#  The values below are safe local-dev defaults — no real secrets. `memory` needs nothing external,
#  so `dotnet run` works out of the box; switch to redis/ef-postgres to exercise those stores (they
#  need the docker-compose services).
# ─────────────────────────────────────────────────────────────────────────────────────────────

# Which ICronnerStore backs the scheduler:
#   memory                  — built-in in-memory store, no external service (default here)
#   redis                   — DotnetCronner.Stores.Redis                       (needs the redis service)
#   ef-postgres             — EF Core store with the package's CronnerDbContext (needs the postgres service)
#   ef-postgres-appcontext  — EF Core store with this app's AppDbContext : ICronnerDbContext
#   custom                  — this app's JsonFileCronnerStore via UseStore<T>()
CRONNER_STORE=memory

# Second-level cache in front of the store: none | redis
CRONNER_CACHE=none

# Attribute-task discovery:
#   auto      — entry assembly + the CronTestApp.ExternalJobs assembly
#   filtered  — same assemblies, but only classes implementing IScheduledJob
#   off       — no scanning; only the Sched(...) lambdas are registered
CRONNER_DISCOVERY=auto

# Where job dependencies come from: app (a scope off the web app's provider) | dedicated (isolated container)
CRONNER_JOB_SERVICES=app

# ── Scheduler options (CronnerOptions) ───────────────────────────────────────────────────────
CRONNER_TIMEZONE=UTC
CRONNER_POLLING_MS=1000
CRONNER_MAX_CONCURRENT=8
# Kept short on purpose: the keepalive renews a running task's claim every LockTtl/2, so 20s means a
# renewal every 10s and the lock:* jobs show several OnKeepAlive events while they run.
CRONNER_LOCK_TTL_SECONDS=20
# Pin the keepalive/OnKeepAlive cadence independently of LockTtl (0 = default LockTtl/2). Keep below LockTtl.
CRONNER_KEEPALIVE_SECONDS=0
# Keep only the newest N finished one-off (enqueued) instances per definition (0 = keep all).
CRONNER_ONEOFF_RETENTION=20
# Record execution history, keeping the newest N runs per task (0 = off). See GET /tasks/{id}/history.
CRONNER_EXEC_HISTORY=20
# Which DI scope terminal hooks (OnStart/OnSuccess/OnFail/OnCancel) run in:
#   shared    — the job's own scope (default); a hook can read the job's scoped services
#   isolated  — each hook gets its own fresh scope (won't contend with a single-session unit of work)
CRONNER_HOOK_SCOPE=shared
# A cron that parses but never fires (e.g. 31 Feb): mark-failed (default, mark that task Failed) | throw (fail startup)
CRONNER_INVALID_SCHEDULE=mark-failed
CRONNER_MAX_RETRIES=2
CRONNER_RETRY_DELAY_SECONDS=5

# Makes the global OnKeepAlive hook block for this long (0 = off). Set it ABOVE LockTtl/2 — e.g. 15000
# with a 20s TTL — and GET /locks must still show renewals every ~10s: keepalive hooks are fired detached,
# so slow hook code can never stretch the cadence or eat into the lock's TTL margin.
CRONNER_SLOW_KEEPALIVE_MS=0

# ── Connections (host values; docker compose overrides them with service names) ───────────────
# StackExchange.Redis connection string — auth + TLS travel inline for a secured server, e.g.
#   myhost:6380,user=cronner,password=SECRET,ssl=true,sslHost=myhost
CRONNER_REDIS=localhost:6379
CRONNER_REDIS_KEY_PREFIX=cronner:
CRONNER_REDIS_CACHE_TTL_SECONDS=60
CRONNER_POSTGRES=Host=localhost;Port=5432;Database=cronner;Username=cronner;Password=cronner
CRONNER_CUSTOM_STORE_FILE=cronner-store.json

# ── Infrastructure used by docker-compose.yml (local dev only — not real credentials) ─────────
APP_HTTP_PORT=8080
POSTGRES_PORT=5432
POSTGRES_DB=cronner
POSTGRES_USER=cronner
POSTGRES_PASSWORD=cronner
REDIS_PORT=6379
ASPNETCORE_ENVIRONMENT=Development
